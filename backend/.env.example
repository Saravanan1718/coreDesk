APP_NAME=IronDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=irondesk
DB_USERNAME=irondesk
DB_PASSWORD=secret

# ── Session ───────────────────────────────────────────────────────────────────
# SESSION_LIFETIME is 480 minutes (8 hours) per the security spec (Req 13.4).
# Switch SESSION_DRIVER to redis once the Redis container is confirmed running.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue & Cache ─────────────────────────────────────────────────────────────
# Switch both to 'redis' for production / full stack.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
STORAGE_DISK_PUBLIC=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
# Set MAIL_MAILER=smtp and point to Mailpit (port 1025) for local dev.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@irondesk.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object Storage (S3 / MinIO) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
